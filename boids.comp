#version 450
layout(local_size_x = 256) in;

struct Boid { vec4 position; vec4 velocity; };

layout(std140, binding = 0) uniform UBO {
    float deltaT;
    uint boidCount;
    float rule1Distance;
    float rule2Distance;
    float rule3Distance;
    float rule1Scale;
    float rule2Scale;
    float rule3Scale;
    float maxSpeed;
    float audioReactivity;
    float bassLevel;
    float trebleLevel;
    float padding;
} ubo;

layout(std430, binding = 1) readonly buffer InBoids { Boid inBoids[]; };
layout(std430, binding = 2) buffer OutBoids { Boid outBoids[]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= ubo.boidCount) return;

    vec3 pos = inBoids[index].position.xyz;
    vec3 vel = inBoids[index].velocity.xyz;
    vec3 center = vec3(0.0); vec3 separate = vec3(0.0); vec3 align = vec3(0.0);
    int count1 = 0, count3 = 0;

    for (uint i = 0; i < ubo.boidCount; i++) {
        if (i == index) continue;
        vec3 otherPos = inBoids[i].position.xyz;
        vec3 otherVel = inBoids[i].velocity.xyz;
        float d = distance(pos, otherPos);
        if (d < ubo.rule1Distance) { center += otherPos; count1++; }
        if (d < ubo.rule2Distance) { separate -= (otherPos - pos); }
        if (d < ubo.rule3Distance) { align += otherVel; count3++; }
    }

    float currentRule1Scale = max(0.0, ubo.rule1Scale - (ubo.bassLevel * 0.05));
    float currentRule3Scale = ubo.rule3Scale + (ubo.trebleLevel * 0.05);
    
    
    float currentRule2Scale = ubo.rule2Scale + (ubo.bassLevel * 0.5); 

    if (count1 > 0) { center /= float(count1); vel += (center - pos) * currentRule1Scale; }
    vel += separate * currentRule2Scale;
    if (count3 > 0) { align /= float(count3); vel += align * currentRule3Scale; }

    vec3 origin = vec3(0.0, 0.0, 0.0);
    float pullStrength = max(0.0, 0.005 - (ubo.bassLevel * 0.01));
    vel += (origin - pos) * pullStrength;

    float dynamicMaxSpeed = ubo.maxSpeed + (ubo.bassLevel * 3.0);
    if (length(vel) > dynamicMaxSpeed) vel = normalize(vel) * dynamicMaxSpeed;

    pos += vel * ubo.deltaT;

    if (pos.x < -4.0) pos.x += 8.0; if (pos.x > 4.0) pos.x -= 8.0;
    if (pos.y < -4.0) pos.y += 8.0; if (pos.y > 4.0) pos.y -= 8.0;
    if (pos.z < -4.0) pos.z += 8.0; if (pos.z > 4.0) pos.z -= 8.0;

    outBoids[index].position = vec4(pos, 1.0);
    outBoids[index].velocity = vec4(vel, 0.0);
}